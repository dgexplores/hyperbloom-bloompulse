APP_ENV=development

# Everything below is read by the app. Nothing else is.
# Defaults live in backend/app/main.py.

# 0 disables rate limiting entirely. The analyse endpoints do real CPU work.
RATE_LIMIT_PER_MINUTE=60

# How many proxies sit between the caller and this process, so the rate limiter
# can find the real client in x-forwarded-for. 1 on Vercel, 0 to ignore the
# header and key on the socket address instead.
TRUSTED_PROXY_HOPS=1

# Optional. Leave blank for the keyless public demo.
# API_KEY=

# Comma-separated allowlist. Defaults to * because the demo is public and
# carries no credentials or user data.
# CORS_ORIGINS=https://hyperbloom-bloompulse.vercel.app

LOG_LEVEL=INFO
